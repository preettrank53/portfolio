# ==========================================
# OPEN SOURCE ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env.local and fill in the values before running locally.
# DO NOT commit your actual .env.local file with real credentials!

# ------------------------------------------
# REDIS (UPSTASH)
# Required for: Signature Wall, Analytics/View Counters, Like Counts
# ------------------------------------------
# Get these free by creating a Redis database at upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------
# ADMIN MODE
# Required for: Adding/editing/pinning portfolio entries via UI
# ------------------------------------------
# Set a strong, secure password for the admin dashboard.
# DO NOT use a weak password in production.
ADMIN_PASSWORD=""
